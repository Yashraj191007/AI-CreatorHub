datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// User model storing relational account references for subscription billing
/// PK: id (String)
model User {
  id            String         @id
  email         String         @unique
  subscriptions Subscription[] /// 1:N relationship with Subscription
}

/// Plan model storing subscription tiers (e.g. Free, Pro, Enterprise)
/// PK: id (UUID)
model Plan {
  id            String         @id @default(uuid())
  name          String         @unique
  price         Decimal        @db.Decimal(10, 2)
  features      PlanFeature[]  /// 1:N relationship with PlanFeature
  subscriptions Subscription[] /// 1:N relationship with Subscription
}

/// PlanFeature model storing features for each plan
/// PK: id (UUID), FK: planId -> Plan.id
model PlanFeature {
  id          String @id @default(uuid())
  planId      String
  description String
  
  /// FK Relation: Plan (1) -> PlanFeature (N) with Cascading Delete
  plan        Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  @@index([planId])
}

/// Subscription model linking Users to Plans with status and active dates
/// PK: id (UUID), FK: userId -> User.id, FK: planId -> Plan.id
model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String   // 'active', 'canceled', 'past_due'
  startDate DateTime @default(now())
  endDate   DateTime
  
  /// FK Relation: User (1) -> Subscription (N) with Cascading Delete
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FK Relation: Plan (1) -> Subscription (N) with Restrict Delete
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[] /// 1:N relationship with Payment
  
  @@index([userId])
  @@index([planId])
}

/// Payment model tracking transaction records for Subscriptions
/// PK: id (UUID), FK: subscriptionId -> Subscription.id
model Payment {
  id             String       @id @default(uuid())
  subscriptionId String
  amount         Decimal      @db.Decimal(10, 2)
  status         String       // 'success', 'failed', 'pending'
  paymentDate    DateTime     @default(now())

  /// FK Relation: Subscription (1) -> Payment (N) with Cascading Delete
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  @@index([subscriptionId])
}

