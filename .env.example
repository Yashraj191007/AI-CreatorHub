# Application Configuration
PORT=5000
# Base application / trusted frontend URL for CORS allowlist and OAuth redirect resolution
APP_URL=http://localhost:5000
# Optional: Comma-separated list of additional trusted frontend origins for CORS
# In production, CORS strictly enforces allowlist matching APP_URL and CORS_ALLOWED_ORIGINS
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# MongoDB Configuration (Mongoose Document Store)
MONGODB_URI=mongodb://localhost:27017/ai-creatorhub

# PostgreSQL / Prisma Configuration (Relational Billing Store)
# Pooled connection string for runtime queries (Neon PgBouncer endpoint)
DATABASE_URL=postgresql://user:password@localhost:5432/aicreatorhub_db
# Direct unpooled connection string for Prisma CLI migrations (Neon direct endpoint)
DIRECT_URL=postgresql://user:password@localhost:5432/aicreatorhub_db

# Authentication Security (JWT Token Signing)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Service (Google Gemini SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (OAuth Exchange Store, Distributed Cron Locking, Caching)
# In production (e.g. Render with Upstash Redis AWS Mumbai ap-south-1), use the TLS-enabled connection string:
# REDIS_URL=rediss://default:your_upstash_password@your-upstash-db.upstash.io:6379
# In local development, defaults to local unencrypted Redis:
REDIS_URL=redis://localhost:6379

# Cron Job Configuration
# In production, set to true on the designated instance to enable daily cleanup. Defaults to false in production.
ENABLE_CRON=true
AI_REQUEST_RETENTION_DAYS=90

# Google OAuth 2.0 Social Authentication
# Obtain credentials from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Initial Administrator Provisioning (Optional bootstrap for production)
# When deploying to a fresh production database, specify these to create the first admin securely (minimum 12 characters).
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
INITIAL_ADMIN_NAME=Platform Administrator


